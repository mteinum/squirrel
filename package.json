{
  "name": "squirrel-safari",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "data:park": "tsx scripts/refresh-park.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.html README.md"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.4",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
